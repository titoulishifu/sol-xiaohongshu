# Required: password used on the OAuth authorization screen.
OWNER_PASSWORD=replace-with-a-long-unique-password

# Required: secret used to sign OAuth codes/tokens. Use a long random value.
OAUTH_SIGNING_SECRET=replace-with-at-least-32-random-characters

# Production only. Set this to the final HTTPS origin after deployment.
# Example: https://sol-xiaohongshu.onrender.com
PUBLIC_BASE_URL=

# Optional. The gateway generates an ephemeral private upstream token if omitted.
UPSTREAM_AUTH_TOKEN=

# Optional. Forwarded to xpzouying/xiaohongshu-mcp.
XHS_PROXY=

# Optional. Only set this during OpenAI domain verification if the portal gives you a token.
OPENAI_APPS_CHALLENGE=

# Optional. Defaults are appropriate for ChatGPT/OpenAI OAuth callbacks.
OAUTH_ALLOWED_REDIRECT_HOSTS=chatgpt.com,openai.com,localhost,127.0.0.1
